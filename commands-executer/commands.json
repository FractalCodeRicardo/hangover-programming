[
  {
    "name": "Find file named lion.txt",
    "commands": ["fd lion.txt"]
  },
  {
    "name": "Find files containing lion in name",
    "commands": ["fd lion"]
  },
  {
    "name": "Case-sensitive search for Tiger",
    "commands": ["fd -s Tiger"]
  },
  {
    "name": "Find files matching regex",
    "commands": ["fd 'lion|tiger'"]
  },
  {
    "name": "Find all txt files",
    "commands": ["fd -e txt"]
  },
  {
    "name": "Find all json files",
    "commands": ["fd -e json"]
  },
  {
    "name": "Find all markdown files",
    "commands": ["fd -e md"]
  },
  {
    "name": "Find files ending with xt",
    "commands": ["fd 'xt$'"]
  },
  {
    "name": "Find files starting with e",
    "commands": ["fd '^e'"]
  },
  {
    "name": "Find only directories",
    "commands": ["fd -t d"]
  },
  {
    "name": "Find only files",
    "commands": ["fd -t f"]
  },
  {
    "name": "Search inside mammals directory",
    "commands": ["fd . mammals"]
  },
  {
    "name": "Include hidden files",
    "commands": ["fd -H"]
  },
  {
    "name": "Search everything that contains r",
    "commands": ["fd -u r"]
  },
  {
    "name": "Exclude reptiles directory",
    "commands": ["fd --exclude reptiles"]
  },
  {
    "name": "Show absolute paths",
    "commands": ["fd -a lion"]
  },
  {
    "name": "Delete all tmp files",
    "commands": ["touch temp-file.tmp", "fd -e tmp -X rm", "ls"]
  },
  {
    "name": "Count txt files",
    "commands": ["fd -e txt | wc -l"]
  },
  {
    "name": "Open selected file with fzf",
    "commands": ["fd | fzf"]
  },
  {
    "name": "Open selected file in nvim",
    "commands": ["fd | fzf | xargs nvim", "lion.txt", ":q"]
  },
  {
    "name": "Find files and show details",
    "commands": ["fd lion -x stat"]
  },
  {
    "name": "Find files with numbers in name",
    "commands": ["fd '[0-9]'"]
  },
  {
    "name": "Count directories",
    "commands": ["fd -t d | wc -l"]
  },
  {
    "name": "Count files",
    "commands": ["fd -t f | wc -l"]
  },
  {
    "name": "Find files larger than 100 bytes",
    "commands": ["find . -type f -size +100c"]
  },
  {
    "name": "Find files smaller than 1 KB",
    "commands": ["find . -type f -size -1k"]
  },
  {
    "name": "Find empty files",
    "commands": ["find . -type f -empty"]
  },
  {
    "name": "Find empty directories",
    "commands": ["find . -type d -empty"]
  },
  {
    "name": "Find files modified today",
    "commands": ["find . -mtime -1"]
  },
  {
    "name": "Find files older than 5 days",
    "commands": ["find . -mtime +5"]
  },
  {
    "name": "Find files accessed today",
    "commands": ["find . -atime -1"]
  },
  {
    "name": "Find files owned by current user",
    "commands": ["find . -user $USER"]
  },
  {
    "name": "Delete empty directories",
    "commands": ["find . -type d -empty -delete"]
  },
  {
    "name": "Find largest files",
    "commands": ["find . -type f -exec du -h {} + | sort -hr | head"]
  },
  {
    "name": "Find files not matching pattern",
    "commands": ["find . -type f ! -name '*.txt'"]
  },
  {
    "name": "Find files with spaces in name",
    "commands": ["find . -name '* *'"]
  },
  {
    "name": "Find files and page results",
    "commands": ["fd | less", "q"]
  }
]
